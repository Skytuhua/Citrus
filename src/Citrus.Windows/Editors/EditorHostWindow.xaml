<Window x:Class="Citrus.Windows.Editors.EditorHostWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation" xmlns:e="clr-namespace:Citrus.Windows.Editors" xmlns:i="clr-namespace:Citrus.Windows.Editors.Image"
 Title="Image editor · Citrus" Width="520" Height="620" MinWidth="420" MinHeight="440" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}">
 <p:MaterialSurface x:Name="Chrome"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="60"/></Grid.RowDefinitions>
  <p:ChromeHeader><TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></p:ChromeHeader>
  <Grid Grid.Row="1" Margin="16,10,16,0"><Grid.RowDefinitions><RowDefinition Height="1.25*" MinHeight="100"/><RowDefinition Height="*" MinHeight="64"/></Grid.RowDefinitions>
   <Border Margin="0,0,0,8" Background="#151718" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="1" x:Name="PreviewArea" Margin="10" ClipToBounds="True"><Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/><e:CropOverlay x:Name="CropHandles" Visibility="Collapsed" AutomationProperties.Name="Crop handles; arrow keys move crop, numeric fields resize"/><i:AnnotationOverlay x:Name="LayerHandles" Visibility="Collapsed" AutomationProperties.Name="Image layers; select, drag handles, arrow keys nudge, Delete removes"/></Grid>
    <StackPanel Grid.Row="2" Margin="12,8"><WrapPanel x:Name="PreviewTools" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" Click="ZoomOut" Style="{DynamicResource TertiaryButton}" Foreground="#F5F7F7" AutomationProperties.Name="Zoom out"/><Button x:Name="NativePreviewButton" Content="100%" Click="NativePreview" Style="{DynamicResource TertiaryButton}" Foreground="#F5F7F7" AutomationProperties.Name="View actual output pixels at 100 percent"/><Button Content="+" Click="ZoomIn" Style="{DynamicResource TertiaryButton}" Foreground="#F5F7F7" AutomationProperties.Name="Zoom in"/><TextBlock x:Name="ZoomValue" Text="Fit" Foreground="#D4D9DC" Margin="6,0" VerticalAlignment="Center"/><Button x:Name="FitPreviewButton" Content="Fit" Click="FitPreview" Style="{DynamicResource TertiaryButton}" Foreground="#F5F7F7" AutomationProperties.Name="Fit whole image in preview"/><Button Content="Reset" Click="Reset" Style="{DynamicResource TertiaryButton}" Foreground="#F5F7F7"/><CheckBox x:Name="OriginalPreview" Content="Original" Click="OriginalChanged" VerticalAlignment="Center" Foreground="#F5F7F7" Margin="8,0" AutomationProperties.Name="Compare original image"/></WrapPanel><TextBlock x:Name="PreviewStatus" Foreground="#D4D9DC" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><CheckBox x:Name="DetailPreview" Foreground="#D4D9DC" Content="100% detail" Click="DetailChanged" FontSize="{DynamicResource MetadataSize}"/></StackPanel>
   </Grid></Border>
   <Border Grid.Row="1" Background="{DynamicResource MaterialContentSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,8"><StackPanel>
    <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{DynamicResource TertiaryButton}" Content="Undo" ToolTip="Undo · Ctrl+Z" Click="Undo"/><Button Style="{DynamicResource TertiaryButton}" Content="Redo" ToolTip="Redo · Ctrl+Y" Click="Redo"/><Button Style="{DynamicResource TertiaryButton}" Content="Reset" Click="Reset"/></StackPanel><TextBlock Text="Tool" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <ComboBox x:Name="ToolPicker" ItemsSource="{Binding Tools}" SelectionChanged="ToolChanged" AutomationProperties.Name="Image tool" Margin="0,0,0,12"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <StackPanel x:Name="Inspector"/>
    <Expander Margin="0,10" IsExpanded="False"><Expander.Header><TextBlock x:Name="SourceHeading" Text="Images" TextTrimming="CharacterEllipsis"/></Expander.Header><StackPanel>
     <ListBox x:Name="SourceList" MaxHeight="160" SelectionChanged="SelectSource" AutomationProperties.Name="Preview source; checkboxes control export inclusion" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><CheckBox IsChecked="{Binding Included}" VerticalAlignment="Center" Click="InclusionChanged" AutomationProperties.Name="Include source in export" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Margin="0,6,0,0"><Button Style="{DynamicResource TertiaryButton}" Content="Add images…" Click="AddImages"/><Button Style="{DynamicResource TertiaryButton}" Content="Reload image" Click="ReloadImage"/></WrapPanel>
    </StackPanel></Expander>
    <Expander Header="Batch settings" Margin="0,16,0,8"><StackPanel>
     <TextBlock Text="Included images only" TextWrapping="Wrap" Margin="0,8"/>
     <ComboBox x:Name="MappingMode" SelectedIndex="0" Margin="0,8" AutomationProperties.Name="Batch crop mapping"><ComboBoxItem><TextBlock Text="Relative crop" TextWrapping="Wrap"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Pixels (crop must fit)" TextWrapping="Wrap"/></ComboBoxItem></ComboBox>
     <Button Style="{DynamicResource SecondaryButton}" Content="Apply to all" Click="ApplyAll"/>
    </StackPanel></Expander>
    <Expander Header="Save location" Margin="0,8"><StackPanel><TextBlock x:Name="DestinationText" TextWrapping="Wrap" Margin="0,8" FontSize="{DynamicResource MetadataSize}"/><Button Style="{DynamicResource SecondaryButton}" Content="Choose folder…" Click="ChooseFolder"/></StackPanel></Expander>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="20,10,20,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="IncludedText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource MetadataSize}" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{DynamicResource SecondaryButton}" Content="Cancel" Click="Cancel" Margin="0,0,8,0"/><Button x:Name="ExportButton" Style="{DynamicResource PrimaryButton}" Content="Save" Click="Export"/></StackPanel>
  </Grid></Border>
 </Grid></p:MaterialSurface>
</Window>
