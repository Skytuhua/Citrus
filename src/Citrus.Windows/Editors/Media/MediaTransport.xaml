<UserControl x:Class="Citrus.Windows.Editors.Media.MediaTransport"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:media="clr-namespace:Citrus.Windows.Editors.Media"
 Background="{DynamicResource MaterialContentSurface}" Foreground="{DynamicResource PrimaryText}"
 FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}">
 <Grid Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Picture" Background="#17191B" ClipToBounds="True" MinHeight="60">
   <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="Exact video preview"/>
   <Border x:Name="VideoStatusOverlay" Panel.ZIndex="10" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="8" Padding="8,6"
      CornerRadius="7" MaxHeight="72" Background="{DynamicResource MaterialContentSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <TextBlock x:Name="VideoStatus" Text="{Binding Text,ElementName=Status}" ToolTip="{Binding Text,ElementName=Status}"
      AutomationProperties.Name="{Binding Text,ElementName=Status}" AutomationProperties.LiveSetting="Polite"
      Foreground="{DynamicResource PrimaryText}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"/>
   </Border>
  </Grid>
  <media:WaveformView x:Name="Waveform" Grid.Row="1" Foreground="{DynamicResource Accent}"/>
  <ContentPresenter x:Name="SelectionAdornment" Grid.Row="2" Margin="0,4,0,0"/>
  <Slider x:Name="Timeline" Grid.Row="3" Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="1"
    PreviewMouseLeftButtonUp="SeekReleased" PreviewKeyUp="SeekKeyReleased" AutomationProperties.Name="Playback position in seconds"/>
  <WrapPanel Grid.Row="4" Margin="0,4,0,0" VerticalAlignment="Center">
   <Button x:Name="Play" Content="Play" Click="PlayClicked" Style="{DynamicResource CitrusButton}" MinWidth="36" MinHeight="28" Padding="8,3" Margin="0,0,6,0"/>
   <Button x:Name="Pause" Content="Pause" Click="PauseClicked" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
   <Button x:Name="Stop" Content="Stop" Click="StopClicked" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
   <Button x:Name="Previous" Content="Previous frame" Click="PreviousClicked" Style="{DynamicResource TertiaryButton}" Padding="8,3" MinHeight="28" Margin="0,0,4,0" ToolTip="Previous frame" AutomationProperties.Name="Previous video frame"/>
   <Button x:Name="Next" Content="Next frame" Click="NextClicked" Style="{DynamicResource TertiaryButton}" Padding="8,3" MinHeight="28" Margin="0,0,8,0" ToolTip="Next frame" AutomationProperties.Name="Next video frame"/>
   <CheckBox x:Name="Original" Content="Original" VerticalAlignment="Center" Click="OriginalClicked"
     ToolTip="Compare without effects. Trims, order and speed stay applied."/>
   <TextBlock x:Name="Timecode" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
  </WrapPanel>
  <TextBlock x:Name="Status" Grid.Row="5" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
