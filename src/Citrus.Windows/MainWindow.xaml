<Window x:Class="Citrus.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus" Width="840" Height="620" MinWidth="620" MinHeight="440" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" WindowStartupLocation="CenterScreen" SizeChanged="WorkspaceResized" TextBlock.LineHeight="{DynamicResource BodyLeading}" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="Keycap" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="4,0"/></Style>
  <Style x:Key="MenuKeycap" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0.7"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,4"/><Setter Property="MinWidth" Value="46"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="MenuIcon" TargetType="Path"><Setter Property="Stroke" Value="{DynamicResource SecondaryText}"/><Setter Property="StrokeThickness" Value="1.5"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Metadata" TargetType="TextBlock" BasedOn="{StaticResource MetadataText}"/>
 </Window.Resources>
 <p:MaterialSurface x:Name="Chrome">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <p:ChromeHeader><TextBlock Text="Citrus" FontWeight="SemiBold" FontSize="16"/></p:ChromeHeader>
 <Grid x:Name="LauncherRoot" Grid.Row="1" Visibility="Collapsed" Margin="24,16,24,20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="LauncherScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Background="{DynamicResource PanelBackground}" CornerRadius="18" Padding="24" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped" AutomationProperties.Name="Drop a file">
    <StackPanel><Image Source="{StaticResource CitrusMark}" Width="44" Height="44" Margin="0,0,0,12"/><TextBlock Text="Drop a file" FontSize="{DynamicResource EditorTitleSize}" FontWeight="SemiBold" HorizontalAlignment="Center"/><Button Content="Add files…" Click="ChooseFiles" Style="{DynamicResource MenuPrimaryButton}" HorizontalAlignment="Center" MinWidth="132" Margin="0,16,0,0"/></StackPanel>
   </Border>
   <TextBlock Text="Drag in Explorer, then tap a key." Style="{StaticResource Metadata}" TextWrapping="Wrap" Margin="4,20,4,8"/>
   <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Path x:Name="LauncherShiftIcon" Data="{StaticResource Icon.Convert}" Style="{StaticResource MenuIcon}"/><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=ShiftModeLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,10"/><Border Grid.Column="2" Style="{StaticResource MenuKeycap}"><TextBlock Text="Shift" FontSize="{DynamicResource MetadataSize}" TextAlignment="Center"/></Border>
    <Path x:Name="LauncherAltIcon" Grid.Row="1" Data="{StaticResource Icon.Tools}" Style="{StaticResource MenuIcon}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Text, ElementName=AltModeLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,10"/><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MenuKeycap}"><TextBlock Text="Alt" FontSize="{DynamicResource MetadataSize}" TextAlignment="Center"/></Border>
    <Path x:Name="LauncherControlIcon" Grid.Row="2" Data="{StaticResource Icon.File}" Style="{StaticResource MenuIcon}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Text, ElementName=ControlModeLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,10"/><Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MenuKeycap}"><TextBlock Text="Ctrl" FontSize="{DynamicResource MetadataSize}" TextAlignment="Center"/></Border>
   </Grid><Button Content="Try the wheel" Click="ShowDemo" Style="{DynamicResource MenuButton}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
  <Border x:Name="LauncherRecent" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12" Visibility="Collapsed"><DockPanel><Button Content="View jobs" Click="OpenWorkspaceClick" Style="{DynamicResource TertiaryButton}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Recent jobs" FontWeight="SemiBold"/><TextBlock x:Name="LauncherJobSummary" TextTrimming="CharacterEllipsis" Style="{StaticResource Metadata}"/></StackPanel></DockPanel></Border>
  <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0.6,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button x:Name="LauncherWorkspaceButton" Content="Open workspace" Click="OpenWorkspaceClick" Style="{DynamicResource MenuButton}" HorizontalAlignment="Left"/><Button x:Name="LauncherSettingsButton" Grid.Column="1" Content="Settings" Click="OpenSettings" Style="{DynamicResource MenuButton}"/></Grid></Border>
 </Grid>
 <Grid x:Name="WorkspaceRoot" Grid.Row="1" Margin="24,16" Background="{DynamicResource WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="WorkspaceHeader" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource CitrusMark}" Width="28" Height="28" Margin="0,0,9,0"/><TextBlock Text="Workspace" FontSize="{DynamicResource EditorTitleSize}" LineHeight="{DynamicResource EditorLeading}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <WrapPanel x:Name="HeaderActions" Grid.Column="1" VerticalAlignment="Center"><Button Content="Home" Click="OpenLauncherClick" Style="{DynamicResource TertiaryButton}" Margin="0,0,8,0"/><Button Content="Settings" Click="OpenSettings" Style="{DynamicResource TertiaryButton}"/></WrapPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="GestureGuide" Style="{StaticResource Metadata}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="Drag a file, then tap Shift to convert, Alt for tools, or Control for files."><Run Text="Drag → "/><InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource Keycap}"><TextBlock Text="Shift" FontSize="{DynamicResource MetadataSize}"/></Border></InlineUIContainer><Run Text=" "/><Run x:Name="ShiftModeLabel" Text="Convert"/><Run Text="   "/><InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource Keycap}"><TextBlock Text="Alt" FontSize="{DynamicResource MetadataSize}"/></Border></InlineUIContainer><Run Text=" "/><Run x:Name="AltModeLabel" Text="Tools"/><Run Text="   "/><InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" FontSize="{DynamicResource MetadataSize}"/></Border></InlineUIContainer><Run Text=" "/><Run x:Name="ControlModeLabel" Text="Files"/></TextBlock>
   <CheckBox x:Name="GesturesEnabled" Grid.Column="1" Content="Wheel gestures" VerticalAlignment="Center" IsChecked="True" Checked="ToggleGestures" Unchecked="ToggleGestures"/>
  </Grid>
  <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="2" SizeChanged="WorkspaceResized" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="WorkspaceFlow">
   <Grid x:Name="WorkspaceGrid">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FileColumn" Width="*"/><ColumnDefinition x:Name="OperationColumn" Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="FilesPanel" Margin="0,0,24,0" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped" AutomationProperties.Name="Drop files and folders here">
     <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource InsetBackground}" CornerRadius="16" Padding="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Active file preview" Margin="0,0,0,8"/>
       <StackPanel x:Name="PreviewFallback" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource Icon.File}" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.4" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewMessage" Text="Drop files here" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
       <TextBlock x:Name="PreviewCaption" Grid.Row="1" Text="File preview" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource MetadataSize}" LineHeight="{DynamicResource MetadataLeading}"/>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,10,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionStatus" Text="0 files included" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Add files" Click="ChooseFiles" Style="{DynamicResource TertiaryButton}"/></Grid>
     <ListBox x:Name="SelectedFiles" Grid.Row="2" MinHeight="64" SelectionMode="Single" SelectionChanged="FileSelectionChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Preview a file; checkboxes choose batch inclusion">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource WorkspaceListItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,6"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="{Binding Name, StringFormat=Include {0} in batch}"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Grid.Row="3" Margin="0,4,0,0"><Button Content="Include all" Click="IncludeAll" Style="{DynamicResource TertiaryButton}" Padding="6,4"/><Button Content="Exclude all" Click="ExcludeAll" Style="{DynamicResource TertiaryButton}" Padding="6,4"/><Button x:Name="RemoveButton" Content="Remove" Click="RemoveFiles" IsEnabled="False" Style="{DynamicResource TertiaryButton}" Padding="6,4"/><Button x:Name="ClearButton" Content="Clear" Click="ClearFiles" IsEnabled="False" Style="{DynamicResource TertiaryButton}" Padding="6,4"/><Button Content="Add folder" Click="ChooseFolder" Style="{DynamicResource TertiaryButton}" Padding="6,4"/></WrapPanel>
    </Grid>
    <Grid x:Name="CenterPanel" Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource InsetBackground}" CornerRadius="12" Padding="3" Margin="0,0,0,16">
      <ListBox x:Name="Modes" ItemContainerStyle="{StaticResource SegmentedItem}" SelectionChanged="ModeChanged" SelectedIndex="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="Operation mode"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="Convert"/><ListBoxItem Content="Tools"/><ListBoxItem Content="Files"/></ListBox>
     </Border>
     <TextBlock x:Name="OperationsHeading" Grid.Row="1" Text="Choose an operation" FontSize="{DynamicResource SectionSize}" LineHeight="{DynamicResource SectionLeading}" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock x:Name="OperationsEmpty" Grid.Row="2" TextWrapping="Wrap" Style="{StaticResource Metadata}" Margin="0,0,0,8"/>
     <ListBox x:Name="Operations" Grid.Row="3" SelectionChanged="OperationChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Operations supported by all included files">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource WorkspaceListItem}"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><DockPanel><Path Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Metadata}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border x:Name="EmptyState" Grid.ColumnSpan="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped" AutomationProperties.Name="Drop files to begin">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Image Source="{StaticResource CitrusMark}" Width="56" Height="56" Margin="0,0,0,20"/><TextBlock Text="Drop your files" FontSize="{DynamicResource EditorTitleSize}" LineHeight="{DynamicResource EditorLeading}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><Button Content="Add files" Click="ChooseFiles" MinWidth="140" HorizontalAlignment="Center" Margin="0,24,0,0"/><Button Content="Add a folder" Click="ChooseFolder" Style="{DynamicResource TertiaryButton}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
    </Border>
   </Grid>
  <Expander x:Name="JobsPanel" Margin="0,8,0,0" Foreground="{DynamicResource PrimaryText}" Visibility="Collapsed">
   <Expander.Header><TextBlock x:Name="JobSummary" Text="Jobs" FontWeight="SemiBold" TextWrapping="Wrap"/></Expander.Header>
   <StackPanel><ItemsControl x:Name="SubmissionFailures"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,8,0,0"><DockPanel><Button Content="Retry" Style="{DynamicResource SecondaryButton}" Tag="{Binding}" Click="RetrySubmission" IsEnabled="{Binding CanRetry}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ListBox x:Name="JobList" MaxHeight="420" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="12" Margin="0,8,0,0"><StackPanel>
     <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Cancel" Tag="{Binding}" Click="CancelJob" IsEnabled="{Binding CanCancel}" Style="{DynamicResource SecondaryButton}" Padding="10,4"/><Button Content="Retry" Tag="{Binding}" Click="RetryJob" IsEnabled="{Binding CanRetry}" Style="{DynamicResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/><Button Content="Save elsewhere…" Tag="{Binding}" Click="ChangeDestination" IsEnabled="{Binding CanChooseFolder}" Style="{DynamicResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/></WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Source}" ToolTip="{Binding SourcePaths}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Operation}" Style="{StaticResource Metadata}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="5" Margin="0,8,0,8" AutomationProperties.Name="Conversion progress"/>
     <ItemsControl ItemsSource="{Binding Warnings}" AutomationProperties.Name="Conversion notes"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><Button Content="Reveal" Style="{DynamicResource TertiaryButton}" Tag="{Binding Path}" Click="RevealOutput" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" AutomationProperties.Name="Reveal output in Explorer"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
  </Expander>
  <StackPanel><TextBlock x:Name="Status" Margin="0,12,0,0" Text="" Visibility="Collapsed" Style="{StaticResource Metadata}" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="EngineStatus" Margin="0,12,0,0" Text="" Visibility="Collapsed" Style="{StaticResource Metadata}"/></StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="Inspector" Grid.Row="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,16,0,0" Visibility="Collapsed">
   <Grid x:Name="FooterGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="DestinationSummary" Margin="0,0,16,0"><TextBlock x:Name="InspectorTitle" Text="Choose an operation" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="OutputSummary" Text="Copies saved beside each original" Style="{StaticResource Metadata}"/><TextBlock x:Name="SafetySummary" Style="{StaticResource Metadata}" Visibility="Collapsed"/><TextBlock x:Name="OperationHint" Visibility="Collapsed"/><TextBlock x:Name="BatchSummary" Visibility="Collapsed"/></StackPanel>
    <Button x:Name="RunButton" Grid.Column="1" Content="Create copies" Click="RunOperation" IsEnabled="False" MinWidth="144" VerticalAlignment="Center" ToolTip="{Binding Text, ElementName=SafetySummary}"/>
   </Grid>
  </Border>

 </Grid>
 </Grid>
 </p:MaterialSurface>
</Window>
