<Window x:Class="Citrus.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus settings" Width="440" Height="560" MinWidth="380" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}" UseLayoutRounding="True">
 <p:MaterialSurface x:Name="Chrome">
 <DockPanel>
  <p:ChromeHeader DockPanel.Dock="Top"><TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/></p:ChromeHeader>
  <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,12"><TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{DynamicResource ErrorText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel" Style="{DynamicResource MenuButton}"/><Button x:Name="SaveSettingsButton" Content="Save" Click="Save" IsDefault="True" Style="{DynamicResource MenuPrimaryButton}" Margin="8,0,0,0"/></StackPanel></StackPanel>
  <ScrollViewer x:Name="SettingsScroll" Background="{DynamicResource MaterialContentSurface}" Padding="20,12" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="General" FontSize="{DynamicResource SectionSize}" FontWeight="SemiBold" Margin="0,4,0,14"/>
   <CheckBox x:Name="Startup" Margin="0,0,0,12"><TextBlock Text="Launch quietly at sign-in" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Sound" Margin="0,0,0,12"><TextBlock Text="Play wheel selection sound" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Motion" Margin="0,0,0,12"><TextBlock Text="Reduce motion" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Transparency" Margin="0,0,0,12"><TextBlock Text="Reduce transparency" TextWrapping="Wrap"/></CheckBox>
   <CheckBox x:Name="Reveal" Margin="0,0,0,12"><TextBlock Text="Reveal completed outputs in Explorer" TextWrapping="Wrap"/></CheckBox>
   <Label Content="_Theme" Target="{Binding ElementName=Theme}"/><ComboBox x:Name="Theme" AutomationProperties.Name="Theme"/>
   <TextBlock Text="Updates" FontSize="{DynamicResource SectionSize}" FontWeight="SemiBold" Margin="0,24,0,10"/>
   <CheckBox x:Name="AutomaticUpdates" Margin="0,0,0,10"><TextBlock Text="Update automatically when idle" TextWrapping="Wrap"/></CheckBox>
   <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Style="{StaticResource MetadataText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
   <WrapPanel><Button x:Name="CheckUpdates" Content="Check for updates" Click="CheckForUpdates" Style="{DynamicResource MenuButton}" Margin="0,0,8,8"/>
    <Button x:Name="RestartUpdate" Content="Restart to update" Click="RestartForUpdate" Style="{DynamicResource MenuPrimaryButton}" Visibility="Collapsed" Margin="0,0,8,8"/>
    <Button x:Name="OpenReleases" Content="GitHub releases" Click="OpenGitHubReleases" Style="{DynamicResource MenuButton}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="Wheel gestures" FontSize="{DynamicResource SectionSize}" FontWeight="SemiBold" Margin="0,24,0,10"/>
   <CheckBox x:Name="Gestures" Margin="0,0,0,6"><TextBlock Text="Enable drag gestures" TextWrapping="Wrap"/></CheckBox>
   <TextBlock Text="Hold a key or tap it while dragging." TextWrapping="Wrap" Style="{StaticResource MetadataText}" Margin="0,6,0,14"/>
   <TextBlock Text="Choose a different mode for each key." TextWrapping="Wrap"/>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Content="_Shift" Target="{Binding ElementName=Shift}"/><ComboBox x:Name="Shift" Grid.Column="1" AutomationProperties.Name="Shift gesture mode"/>
    <Label Content="_Alt" Grid.Row="1" Target="{Binding ElementName=Alt}"/><ComboBox x:Name="Alt" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Alt gesture mode"/>
    <Label Content="_Control" Grid.Row="2" Target="{Binding ElementName=Control}"/><ComboBox x:Name="Control" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Control gesture mode"/>
   </Grid>
  </StackPanel></ScrollViewer>
 </DockPanel>
 </p:MaterialSurface>
</Window>
