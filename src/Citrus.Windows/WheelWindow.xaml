<Window x:Class="Citrus.Windows.WheelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
 Title="Citrus wheel" Width="368" Height="454" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False" UseLayoutRounding="True" FontFamily="{DynamicResource AppFont}">
 <Viewbox Stretch="Uniform">
 <Canvas x:Name="Surface" Width="368" Height="454" Background="#01000000" AllowDrop="True" Focusable="False">
  <Canvas x:Name="Presentation" Width="368" Height="454" IsHitTestVisible="False">
   <p:MaterialSurface x:Name="Shell" Role="WheelShell" Width="352" Height="352" Canvas.Left="8" Canvas.Top="8"/>
   <Image x:Name="GlassBody" Width="368" Height="454" Stretch="Fill" Visibility="Collapsed"/>
   <Image x:Name="GlassLighting" Width="368" Height="454" Stretch="Fill" Visibility="Collapsed"/>
   <Canvas x:Name="Sectors" Width="368" Height="368"/>
   <TextBlock x:Name="ModeLabel" Visibility="Collapsed" ClipToBounds="True" Canvas.Left="154" Canvas.Top="237" Width="60" Height="16" LineHeight="16" LineStackingStrategy="BlockLineHeight" Text="CONVERT" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"/>
   <TextBlock x:Name="Badge" Visibility="Collapsed" ClipToBounds="True" Canvas.Left="128" Canvas.Top="214" Width="112" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" Text="Drag a file here" Foreground="{DynamicResource SecondaryText}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Border x:Name="CaptionPlate" Canvas.Left="129" Canvas.Top="160" Width="110" Height="48" CornerRadius="24" Background="{DynamicResource CapsuleBackground}">
    <Grid><Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="*"/><RowDefinition x:Name="HintRow" Height="0"/></Grid.RowDefinitions>
     <TextBlock x:Name="Caption" Text="Choose" TextAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="16.5" FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

    </Grid>
   </Border>
   <Border x:Name="NavigationPlate" Canvas.Left="86" Canvas.Top="372" Width="196" Height="36" CornerRadius="18" Background="{DynamicResource CapsuleBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.7" Padding="2" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <Border x:Name="Previous" Width="32" Height="32" CornerRadius="15" Background="Transparent" ToolTip="Previous page · hold while dragging" AutomationProperties.Name="Previous page, hold while dragging"><Path Data="M 8,1 L 2,7 L 8,13" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock x:Name="Hint" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" FontSize="14.1666666667" FontWeight="Medium" Foreground="{DynamicResource PrimaryText}" Text="1 / 2"/>
     <Border x:Name="Next" Grid.Column="2" Width="32" Height="32" CornerRadius="15" Background="Transparent" ToolTip="Next page · hold while dragging" AutomationProperties.Name="Next page, hold while dragging"><Path Data="M 2,1 L 8,7 L 2,13" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
   </Border>

  </Canvas>
 </Canvas>
 </Viewbox>
</Window>
