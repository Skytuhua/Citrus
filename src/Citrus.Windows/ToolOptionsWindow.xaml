<Window x:Class="Citrus.Windows.ToolOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Citrus.Windows.Presentation"
        Title="Options · Citrus" Width="480" Height="540" MinWidth="380" MinHeight="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource BodySize}" TextBlock.LineHeight="{DynamicResource BodyLeading}">
 <p:MaterialSurface x:Name="Chrome">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <p:ChromeHeader><TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></p:ChromeHeader>
    <ScrollViewer Background="{DynamicResource MaterialContentSurface}" Padding="24,18" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="InputSummary" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="OperationDescription" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,16"/>
      <StackPanel x:Name="GroupPanel" Visibility="Collapsed">
        <TextBlock Text="Input order" FontWeight="SemiBold"/><TextBlock Text="Name comes from the first file." Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,8"/>
        <ListBox x:Name="OrderedInputs" Height="150" SelectionChanged="OrderSelectionChanged" AutomationProperties.Name="Ordered group inputs">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><Button x:Name="MoveUpButton" Content="Move up" Click="MoveUp" Margin="0,0,8,0"/><Button x:Name="MoveDownButton" Content="Move down" Click="MoveDown"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="Fields"/>
      <TextBlock x:Name="InspectionSummary" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0"/>
      <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12" Margin="0,16,0,0"><StackPanel>
        <TextBlock Text="Save copies to" FontWeight="SemiBold"/>
        <TextBlock x:Name="DestinationText" TextWrapping="Wrap" Margin="0,6,0,8"/>
        <Button Content="Choose folder…" Click="ChooseFolder" HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}"/>
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorText}" Margin="24,12" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Grid.Row="3" Margin="24,0,24,20" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="CreateButton" Content="Create copies" IsDefault="True" Click="Create"/></StackPanel>
  </Grid>
 </p:MaterialSurface>
</Window>
